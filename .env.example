# Copie este arquivo para ".env" e preencha com os dados reais do seu banco.
# NUNCA preencha valores reais aqui neste arquivo — ele é o "modelo" público.

# Endereço de conexão do banco PostgreSQL.
# Formato: postgresql://usuario:senha@endereco:porta/nome_do_banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/grazing_hub?schema=public"

# Chave secreta usada pra assinar o "crachá" (cookie) de login.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Opcional fora do Docker: identifica cada publicação para o Next atualizar abas antigas.
# No Docker de produção esse valor é gerado automaticamente durante o build.
NEXT_DEPLOYMENT_ID=""

# Integração SEFAZ (Distribuição de NF-e) — certificado digital A1.
# NUNCA commite o .pfx no repositório nem coloque a senha em outro lugar além daqui.
# Caminho absoluto do arquivo .pfx do certificado A1 da empresa.
SEFAZ_CERTIFICADO_PATH="C:/caminho/para/certificado.pfx"
# Senha do certificado .pfx.
SEFAZ_CERTIFICADO_SENHA="troque-pela-senha-real-do-certificado"
# CNPJ da empresa que consulta (só números, 14 dígitos).
SEFAZ_CNPJ="00000000000000"
# Caminho público da biblioteca JavaScript oficial do Zebra Browser Print.
# Baixe-a da Zebra, hospede-a no próprio domínio (ex.: /browser-print/BrowserPrint.min.js)
# e não aponte para serviços localhost ou origens não confiáveis.
NEXT_PUBLIC_BROWSER_PRINT_SCRIPT_URL="/browser-print/BrowserPrint.min.js"

# Recuperação de senha: remetente validado no provedor e TLS obrigatório (465 ou 587).
# Resend: host smtp.resend.com, usuário resend, senha = chave com permissão de envio.
# Colocar valores reais somente no ambiente privado do servidor/Dokploy.
APP_URL="https://grazinghub.com.br"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORTA="465"
EMAIL_SMTP_USUARIO=""
EMAIL_SMTP_SENHA=""
EMAIL_REMETENTE=""

# iFood: sempre desligado até app, loja de teste e convivência autorizados.
IFOOD_ATIVO=0
IFOOD_PRODUCAO_AUTORIZADA=0
# Recepção real em acompanhamento é separada dos comandos. Manter 0 até liberação expressa.
IFOOD_ACOMPANHAMENTO_PRODUCAO_AUTORIZADO=0
# Uma única loja aprovada para receber dados; vazio bloqueia mesmo com a chave acima.
IFOOD_ACOMPANHAMENTO_MERCHANT_ID=
IFOOD_TESTE_CLIENT_ID=
IFOOD_TESTE_CLIENT_SECRET=
IFOOD_PRODUCAO_CLIENT_ID=
IFOOD_PRODUCAO_CLIENT_SECRET=
# AUTH_SECRET existente também protege tokens e snapshots; conservar no cofre.
