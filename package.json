{
  "name": "grazing-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "lint:design": "node scripts/verificar-tokens-design.mjs && node scripts/verificar-qualidade-visual.mjs",
    "lint:design:relatorio": "node scripts/verificar-qualidade-visual.mjs --relatorio",
    "test:design": "vitest run testes/design-system --maxWorkers=1",
    "lint:visual:referencias": "node scripts/verificar-referencias-visuais.mjs",
    "test:visual:contratos": "node --experimental-strip-types scripts/executar-visual.mjs contratos",
    "test:visual:referencias": "node --experimental-strip-types scripts/executar-visual.mjs referencias",
    "test:visual:comparador": "node --experimental-strip-types scripts/executar-visual.mjs comparador",
    "test": "vitest run",
    "ifood:coletor": "node --conditions=react-server --import tsx scripts/processar-ifood.ts --coletor",
    "ifood:processador": "node --conditions=react-server --import tsx scripts/processar-ifood.ts",
    "teste:visual": "vite --config testes/visual/vite.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-oauth/oauth2-server": "5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.11",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.7",
    "papaparse": "^5.7.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
