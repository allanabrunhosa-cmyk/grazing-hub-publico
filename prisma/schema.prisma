// Índice de consulta por autor: referências conservam os payloads nas auditorias de origem.
// Sem FK de autoria/entidade para preservar a identidade após exclusão lógica ou manutenção.
model AtividadeUsuario {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  sequencia BigInt @unique @default(autoincrement())
  ocorridoEm DateTime @default(now()) @db.Timestamptz(3)
  autorId String?
  autorNome String? @db.VarChar(120)
  atorTipo String @db.VarChar(16)
  atorReferencia String? @db.VarChar(120)
  iniciadorId String?
  origem String @db.VarChar(20)
  modulo String @db.VarChar(40)
  recurso String @db.VarChar(100)
  acao String @db.VarChar(100)
  entidade String @db.VarChar(80)
  entidadeId String? @db.VarChar(160)
  usuarioAfetadoId String?
  resumo String @db.VarChar(240)
  resultado String @db.VarChar(20)
  categoria String @db.VarChar(20)
  correlacaoId String? @db.VarChar(160)
  deduplicacao String? @unique @db.VarChar(200)
  fonteTabela String? @db.VarChar(80)
  fonteId String? @db.VarChar(160)
  antes Json?
  depois Json?
  lojaId String?

  @@unique([fonteTabela, fonteId])
  @@index([autorId, ocorridoEm(sort: Desc), id(sort: Desc)])
  @@index([usuarioAfetadoId, ocorridoEm(sort: Desc), id(sort: Desc)])
}

