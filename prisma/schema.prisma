  totalParcelas Int @default(1)
  parcelamentoId String?
  parcelamento ParcelamentoCartao? @relation(fields: [parcelamentoId], references: [id], onDelete: Restrict)
  estornoDeId String?
  estornoDe ItemFaturaCartao? @relation("EstornoCompra", fields: [estornoDeId], references: [id], onDelete: Restrict)
  estornos ItemFaturaCartao[] @relation("EstornoCompra")
  compensadoComId String? @unique
  compensadoCom ItemFaturaCartao? @relation("CompensacaoItens", fields: [compensadoComId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  compensadoPor ItemFaturaCartao? @relation("CompensacaoItens")
  fornecedorId String?
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  categoriaId String?
