  @@unique([lojaId, externoId])
  @@index([estado, proximaTentativa])
}
model PedidoIfood {
  acompanhamento Boolean @default(false)
  id String @id @default(cuid())
  lojaId String
  loja LojaIfood @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  externoId String
  pedidoId String @unique
  pedido PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  estadoRemoto String @default("DESCONHECIDO")
  ultimoEventoEm DateTime?
  modalidade String
  entregaPor String?
  inicioPreparo DateTime?
  snapshotCifrado String
  pendencia String?
  financeiroPendente Boolean @default(true)
  disputaCifrada String?
  revisaoPendente Boolean @default(false)
  disputaId String?
  disputaAte DateTime?
  acoes AcaoIfood[]
  @@unique([lojaId, externoId])
}
model AcaoIfood {
  origemMcpOperacaoId String?
  id String @id @default(cuid())
  pedidoIfoodId String
  pedidoIfood PedidoIfood @relation(fields: [pedidoIfoodId], references: [id], onDelete: Restrict)
  acao String
  revisao Int
  chave String @unique
  hash String
  corpoCifrado String?
  autorId String
  sessaoVersao Int
  estado String @default("PENDENTE")
  tentativas Int @default(0)
  proximaTentativa DateTime @default(now())
  enviadaEm DateTime?
  erro String?
  createdAt DateTime @default(now())
  @@unique([pedidoIfoodId, acao, revisao])
  @@index([estado, proximaTentativa])
}
// Comandos Merchant não pertencem a um pedido. Reutilizam workers e auditoria,
// com envio durável e leitura oficial posterior para conferir o resultado.
model AcaoMerchantIfood {
  id String @id @default(cuid())
  lojaId String
  loja LojaIfood @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  chave String @unique
  hash String
  acao String
  corpo Json
  antes Json
  resultado Json?
  autorId String
  sessaoVersao Int
  estado String @default("PENDENTE")
  tentativas Int @default(0)
  proximaTentativa DateTime @default(now())
  enviadaEm DateTime?
  erro String?
  createdAt DateTime @default(now())
  @@index([estado, proximaTentativa])
  @@index([lojaId, createdAt])
}

// Identidade permanente do legado. Usa a sequência dos registros de entrada.
